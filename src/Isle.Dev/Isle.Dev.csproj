<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer pack: Isle.exe loads Isle.Dev.dll from its own folder when present (Core/DevPack.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Isle</RootNamespace>
    <AssemblyName>Isle.Dev</AssemblyName>
    <!-- Keep equal to Isle's Version: the loader refuses a pack whose informational version differs. -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Isle.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isle\Isle.csproj" Private="false" />
  </ItemGroup>

  <!-- Developer convenience: running Isle from its bin after a solution build picks up the pack. -->
  <Target Name="CopyPackToIsle" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(MSBuildThisFileDirectory)..\Isle\bin\$(Configuration)\$(TargetFramework)\" SkipUnchangedFiles="true" />
  </Target>

</Project>
