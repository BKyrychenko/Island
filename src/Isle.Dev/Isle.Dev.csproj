<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer pack: Isle.exe loads Isle.Dev.dll from its own folder when present (Core/Packs.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Isle</RootNamespace>
    <AssemblyName>Isle.Dev</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IslePack>true</IslePack>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Isle.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isle\Isle.csproj" Private="false" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
