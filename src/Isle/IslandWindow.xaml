<Window x:Class="Isle.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- One fixed-size transparent window; only the shape below is hit-testable (per-pixel alpha). -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Border x:Name="Pill" Width="120" Height="32" CornerRadius="16" Background="#000000"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" />
    </Grid>
</Window>
